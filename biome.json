{
    "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "ignore": ["**/*.vue"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "overrides": [
        {
            "includes": ["**/*.vue"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": "off",
                        "noInvalidUseBeforeDeclaration": "off"
                    },
                    "style": {
                        "useVueMultiWordComponentNames": "off",
                        "useTemplate": "off"
                    },
                    "suspicious": {
                        "noRedeclare": "off",
                        "noConfusingLabels": "off",
                        "noLabelVar": "off",
                        "noGlobalIsNan": "off"
                    },
                    "complexity": {
                        "noUselessLoneBlockStatements": "off"
                    }
                }
            }
        }
    ],
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}