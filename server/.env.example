# ===== 服务端口 =====
端口=5160

# ===== 数据库 =====
数据库路径=./data/monitor.db

# ===== B 站登录 =====
# 登录二维码会打印在终端；登录成功后凭证缓存到下方路径
B站凭证路径=./data/bili-凭证.json

# ===== LLM 配置 =====
# 默认提供商：deepseek | gemini（两者均走 OpenAI 兼容接口，无需额外 SDK）
LLM默认提供商=deepseek

# DeepSeek（主要）
DeepSeek密钥=
DeepSeek地址=https://api.deepseek.com/v1
DeepSeek模型=deepseek-chat

# Gemini（备用，使用官方 OpenAI 兼容端点）
Gemini密钥=
Gemini地址=https://generativelanguage.googleapis.com/v1beta/openai
Gemini模型=gemini-2.5-flash

# ===== 采集配置 =====
# 定时采集间隔（分钟）
采集间隔分钟=30
# 单次采集每个视频最大评论数
单视频评论上限=500
