{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        /* 基础与输出配置 */
        "rootDir": "src",
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext"
        ],
        /* 类型注入 */
        "types": [
            "bun"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
