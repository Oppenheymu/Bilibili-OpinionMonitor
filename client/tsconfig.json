{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "vite/client",
            "element-plus/global"
        ],
        "jsx": "preserve",
        "resolveJsonModule": true,
        "lib": [
            "ESNext",
            "DOM"
        ],
        "paths": {
            "@": [
                "./src"
            ],
            "@/*": [
                "./src/*"
            ]
        },
        /* Vue 模板生态适配：Element Plus slot 的 row 为索引签名类型、props 传 undefined 常见，
       这两项在纯 Node 项目（参考 NapukettoQQ）有效，但在 Vue 模板检查中误报过多，故覆盖关闭 */
        "noPropertyAccessFromIndexSignature": false,
        "exactOptionalPropertyTypes": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "build/**/*.ts",
        "build/**/*.d.ts",
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.js"
    ]
}
