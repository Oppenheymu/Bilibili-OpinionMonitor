# 本地环境
VITE_USER_NODE_ENV = development

# 路由模式: hash | history
VITE_ROUTER_MODE = hash

# 公共基础路径
VITE_PUBLIC_PATH = /

# Vite 开发服务器配置
VITE_PORT = 5173
VITE_OPEN = false

# 接口地址（通过 Vite proxy 代理到后端）
VITE_API_URL = "/api"

# 开发环境跨域代理，指向本项目的 Hono 服务端（端口 5160）
VITE_PROXY = [["/api","http://localhost:5160"]]

# 应用标题
VITE_GLOB_APP_TITLE = B站舆情监控

# 打包时是否删除 console
VITE_DROP_CONSOLE = false
